# Google OAuth Client ID for Student Sign In
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_API_BASE_URL=http://localhost:3000
VITE_WEBSITE_URL=https://unisole.org

# Curriculum Fallback: allow fallback to hardcoded curriculum when DB returns 0 modules.
# Permitted in local development and staging (*stg* hosts). In production, defaults to false unless explicitly set to "true".
VITE_ALLOW_CURRICULUM_FALLBACK=false

# Lesson HLS Video Upload UI (admin course editor)
VITE_ENABLE_VIDEO_UPLOAD=false
